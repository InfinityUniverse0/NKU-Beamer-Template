% ============================================================
%  Nankai University Beamer Font Theme
%  beamerfontthemeNankai.sty
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeNankai}[2025/05/24 Nankai Font Theme]

\mode<presentation>

% =========================
%  Headline / Footline
% =========================
\setbeamerfont{section in head/foot}{size=\footnotesize, series=\bfseries}
\setbeamerfont{section in head/foot shaded}{size=\footnotesize, series=\normalfont}
\setbeamerfont{subsection in head/foot}{size=\scriptsize}
\setbeamerfont{author in head/foot}{size=\tiny}
\setbeamerfont{title in head/foot}{size=\tiny}
\setbeamerfont{date in head/foot}{size=\tiny}

% =========================
%  Frame title
% =========================
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize, series=\normalfont}

% =========================
%  Title page
% =========================
\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}{size=\large, series=\normalfont}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}

% =========================
%  Blocks
% =========================
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{block body}{size=\small}
\setbeamerfont{block title alerted}{size=\normalsize, series=\bfseries}
\setbeamerfont{block title example}{size=\normalsize, series=\bfseries}

% =========================
%  Table of Contents
% =========================
\setbeamerfont{section in toc}{size=\normalsize, series=\bfseries}
\setbeamerfont{subsection in toc}{size=\small}

% =========================
%  Items
% =========================
\setbeamerfont{itemize/enumerate body}{size=\normalsize}
\setbeamerfont{itemize/enumerate subbody}{size=\small}
\setbeamerfont{itemize/enumerate subsubbody}{size=\footnotesize}

% =========================
%  Caption
% =========================
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}

% =========================
%  Footnote (for citations)
% =========================
\setbeamerfont{footnote}{size=\tiny}
\setbeamerfont{footnote mark}{size=\tiny}

\mode<all>
